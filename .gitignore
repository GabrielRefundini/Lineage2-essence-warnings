# Segredos — NUNCA commitar
.env
*.token

# Sessões gravadas (grandes, e contêm a tela do usuário)
recordings/
*.png
*.bmp

# ...mas os frames de referência dos testes são versionados de propósito:
# são a verdade contra a qual a detecção é verificada, e sem eles um bug de
# leitura só reaparece quando alguém morrer de novo no jogo.
!tests/fixtures/*.png

# Saída em tempo de execução
outbox.jsonl
events.jsonl
logs/
*.log

# Calibração é local da máquina — cada tela tem a sua
calibration.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
